primitive NewlineForm
  """
  Maps a symbol to its newline form. Pony distinguishes a `(` that
  opens a call from one that opens a grouped expression by whether a
  newline precedes it, and likewise for `[` and `-`. ponyc does this
  in `newline_symbols`; this is that function.
  """
  fun apply(k: TokenKind, after_newline: Bool): TokenKind =>
    if not after_newline then
      k
    else
      match k
      | TkLparen => TkLparenNew
      | TkLsquare => TkLsquareNew
      | TkMinus => TkMinusNew
      | TkMinusTilde => TkMinusTildeNew
      else
        k
      end
    end
