  fun text(): (String val | None) => None

primitive TkLexError
  """
  Bytes the lexer could not interpret.
  """
  fun name(): String val => "TkLexError"
  fun text(): (String val | None) => None

type TokenKind is
  ( TkEllipsis
  | TkArrow
  | TkDblarrow
  | TkLshiftTilde
  | TkRshiftTilde
  | TkEqTilde
  | TkNeTilde
  | TkLeTilde
  | TkGeTilde
  | TkLtTilde
  | TkGtTilde
  | TkPlusTilde
  | TkMinusTilde
  | TkMultiplyTilde
  | TkDivideTilde
  | TkModTilde
  | TkRemTilde
  | TkLshift
  | TkRshift
  | TkEq
  | TkNe
  | TkLe
  | TkGe
  | TkChain
  | TkSubtype
  | TkBackslash
  | TkAtLbrace
  | TkLbrace
  | TkRbrace
  | TkLparen
  | TkRparen
  | TkLsquare
  | TkRsquare
  | TkComma
  | TkDot
  | TkTilde
  | TkColon
  | TkSemi
  | TkAssign
  | TkPlus
  | TkMinus
  | TkMultiply
  | TkDivide
  | TkMod
  | TkRem
  | TkAt
  | TkLt
  | TkGt
  | TkPipe
  | TkIsecttype
  | TkEphemeral
  | TkAliased
  | TkQuestion
  | TkUnaryMinus
  | TkConstant
  | TkLparenNew
  | TkLsquareNew
  | TkMinusTildeNew
  | TkMinusNew
  | TkCompileIntrinsic
  | TkUse
  | TkType
  | TkInterface
  | TkTrait
  | TkPrimitive
  | TkStruct
  | TkClass
  | TkActor
  | TkObject
  | TkAs
  | TkIs
  | TkIsnt
  | TkVar
  | TkLet
  | TkEmbed
  | TkNew
  | TkFun
  | TkBe
  | TkIso
  | TkTrn
  | TkRef
  | TkVal
  | TkBox
  | TkTag
  | TkThis
  | TkReturn
  | TkBreak
  | TkContinue
  | TkConsume
  | TkRecover
  | TkIf
  | TkIfdef
  | TkIftypeSet
  | TkThen
  | TkElse
  | TkElseif
  | TkEnd
  | TkFor
  | TkIn
  | TkWhile
  | TkDo
  | TkRepeat
  | TkUntil
  | TkMatch
  | TkWhere
  | TkTry
  | TkWith
  | TkError
  | TkCompileError
  | TkNot
  | TkAnd
  | TkOr
  | TkXor
  | TkDigestof
  | TkAddress
  | TkLocation
  | TkTrue
  | TkFalse
  | TkCapRead
  | TkCapSend
  | TkCapShare
  | TkCapAlias
  | TkCapAny
  | TkTestNoSeq
  | TkTestSeqScope
  | TkTestTryNoCheck
  | TkTestAliased
  | TkTestUpdatearg
  | TkTestExtra
  | TkIfdefand
  | TkIfdefor
  | TkIfdefnot
  | TkIfdefflag
  | TkMatchCapture
  | TkMatchDontcare
  | TkIftype
  | TkId
  | TkString
  | TkInt
  | TkFloat
  | TkWhitespace
  | TkLineComment
  | TkNestedComment
  | TkEof
  | TkLexError
  )
  """
  Every kind of token the lexer can produce.

  `text()` is the token's exact source text where the kind fixes it,
  and `None` where it does not -- an identifier, a literal, a comment,
  a run of whitespace. Only the latter need their text stored.
  """

primitive Keywords
  """
  Recognises the keywords, for a lexer that has just scanned something
  shaped like an identifier.
  """
  fun apply(s: String box): (TokenKind | None) =>
    match s
    | "compile_intrinsic" => TkCompileIntrinsic
    | "use" => TkUse
    | "type" => TkType
    | "interface" => TkInterface
    | "trait" => TkTrait
    | "primitive" => TkPrimitive
    | "struct" => TkStruct
    | "class" => TkClass
    | "actor" => TkActor
    | "object" => TkObject
    | "as" => TkAs
    | "is" => TkIs
    | "isnt" => TkIsnt
    | "var" => TkVar
    | "let" => TkLet
    | "embed" => TkEmbed
    | "new" => TkNew
    | "fun" => TkFun
    | "be" => TkBe
    | "iso" => TkIso
    | "trn" => TkTrn
    | "ref" => TkRef
    | "val" => TkVal
    | "box" => TkBox
    | "tag" => TkTag
    | "this" => TkThis
    | "return" => TkReturn
    | "break" => TkBreak
    | "continue" => TkContinue
    | "consume" => TkConsume
    | "recover" => TkRecover
    | "if" => TkIf
    | "ifdef" => TkIfdef
    | "iftype" => TkIftypeSet
    | "then" => TkThen
    | "else" => TkElse
    | "elseif" => TkElseif
    | "end" => TkEnd
    | "for" => TkFor
    | "in" => TkIn
    | "while" => TkWhile
    | "do" => TkDo
    | "repeat" => TkRepeat
    | "until" => TkUntil
    | "match" => TkMatch
    | "where" => TkWhere
    | "try" => TkTry
    | "with" => TkWith
    | "error" => TkError
    | "compile_error" => TkCompileError
    | "not" => TkNot
    | "and" => TkAnd
    | "or" => TkOr
    | "xor" => TkXor
    | "digestof" => TkDigestof
    | "addressof" => TkAddress
    | "__loc" => TkLocation
    | "true" => TkTrue
    | "false" => TkFalse
    | "#read" => TkCapRead
    | "#send" => TkCapSend
    | "#share" => TkCapShare
    | "#alias" => TkCapAlias
    | "#any" => TkCapAny
    | "$noseq" => TkTestNoSeq
    | "$scope" => TkTestSeqScope
    | "$try_no_check" => TkTestTryNoCheck
    | "$aliased" => TkTestAliased
    | "$updatearg" => TkTestUpdatearg
    | "$extra" => TkTestExtra
    | "$ifdefand" => TkIfdefand
    | "$ifdefor" => TkIfdefor
    | "$ifdefnot" => TkIfdefnot
    | "$flag" => TkIfdefflag
    | "$let" => TkMatchCapture
    | "$dontcare" => TkMatchDontcare
    | "$iftype" => TkIftype
    else
      None
    end

primitive Symbols
  """
  The symbols a scanner can reach, longest first so that taking the
  first match takes the longest -- `<<~` before `<<` before `<`.

  ponyc's table lists some texts twice and its scan takes the first,
  so these are the reachable entries only. Absent, and reachable by
  other means:
  `-` as TkUnaryMinus.
  `(` as TkLparenNew.
  `[` as TkLsquareNew.
  `-~` as TkMinusTildeNew.
  `-` as TkMinusNew.
  """
  fun apply(): Array[(String val, TokenKind)] val =>
    [
      ("...", TkEllipsis)
      ("<<~", TkLshiftTilde)
      (">>~", TkRshiftTilde)
      ("==~", TkEqTilde)
      ("!=~", TkNeTilde)
      ("<=~", TkLeTilde)
      (">=~", TkGeTilde)
      ("%%~", TkModTilde)
      ("->", TkArrow)
      ("=>", TkDblarrow)
      ("<~", TkLtTilde)
      (">~", TkGtTilde)
      ("+~", TkPlusTilde)
      ("-~", TkMinusTilde)
      ("*~", TkMultiplyTilde)
      ("/~", TkDivideTilde)
      ("%~", TkRemTilde)
      ("<<", TkLshift)
      (">>", TkRshift)
      ("==", TkEq)
      ("!=", TkNe)
      ("<=", TkLe)
      (">=", TkGe)
      (".>", TkChain)
      ("<:", TkSubtype)
      ("@{", TkAtLbrace)
      ("%%", TkMod)
      ("\\", TkBackslash)
      ("{", TkLbrace)
      ("}", TkRbrace)
      ("(", TkLparen)
      (")", TkRparen)
      ("[", TkLsquare)
      ("]", TkRsquare)
      (",", TkComma)
      (".", TkDot)
      ("~", TkTilde)
      (":", TkColon)
      (";", TkSemi)
      ("=", TkAssign)
      ("+", TkPlus)
      ("-", TkMinus)
      ("*", TkMultiply)
      ("/", TkDivide)
      ("%", TkRem)
      ("@", TkAt)
      ("<", TkLt)
      (">", TkGt)
      ("|", TkPipe)
      ("&", TkIsecttype)
      ("^", TkEphemeral)
      ("!", TkAliased)
      ("?", TkQuestion)
      ("#", TkConstant)
    ]

